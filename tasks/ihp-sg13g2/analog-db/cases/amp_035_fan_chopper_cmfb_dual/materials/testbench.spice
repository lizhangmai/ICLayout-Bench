let dm=v(outp)-v(outn)
let cm=(v(outp)+v(outn))/2
let s1=(v(s1p)+v(s1n))/2
let dmerror=abs(dm-v(sig))
let int_cm_quiet_v=integ(cm)
let val_cm_quiet_v=cm
let a_cm_quiet_v=int_cm_quiet_v[edge_5u]+(5u-time[edge_5u])*(val_cm_quiet_v[edge_5u]+0.5*frac_edge_5u*(val_cm_quiet_v[edge_5u+1]-val_cm_quiet_v[edge_5u]))
let b_cm_quiet_v=int_cm_quiet_v[edge_9u]+(9u-time[edge_9u])*(val_cm_quiet_v[edge_9u]+0.5*frac_edge_9u*(val_cm_quiet_v[edge_9u+1]-val_cm_quiet_v[edge_9u]))
let cm_quiet_v=(b_cm_quiet_v-a_cm_quiet_v)/(9u-5u)
print cm_quiet_v
let int_cm_pre_kick_v=integ(cm)
let val_cm_pre_kick_v=cm
let a_cm_pre_kick_v=int_cm_pre_kick_v[edge_28u]+(28u-time[edge_28u])*(val_cm_pre_kick_v[edge_28u]+0.5*frac_edge_28u*(val_cm_pre_kick_v[edge_28u+1]-val_cm_pre_kick_v[edge_28u]))
