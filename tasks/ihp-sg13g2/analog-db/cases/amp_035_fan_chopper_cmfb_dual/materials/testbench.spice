* Physical CMFB observations; external differential feedback only. SPDX-License-Identifier: MIT
.lib /workspace/support/models/cornerMOSlv.lib mos_tt
.lib /workspace/support/models/cornerCAP.lib cap_typ
.lib /workspace/support/models/cornerRES.lib res_typ
.include parameters.spice
.include dut.spice
.temp 27
.save v(vdd) v(vb1) v(vb2) v(vb3) v(ref) v(icm) v(sig) v(inp) v(inn) v(fp) v(fn) v(outp) v(outn) v(s1p) v(s1n) v(ctl) i(VDD) i(VB1) i(VB2) i(VB3) i(VREF) v(rs) v(ctl1) i(VRS)
.options rshunt=1e14 pivtol=1e-18 reltol=1e-6 abstol=1e-14 vntol=1e-9 method=gear maxord=2
VDD vdd 0 1.2
VB1 vb1 0 .3983759766
VB2 vb2 0 .65
VB3 vb3 0 .45
VREF ref 0 pulse(.5 {.5+ref_step} 50u 20n 20n 15u 200u)
VRS rs 0 pulse(.3265 {.3265+s1_step} 110u 20n 20n 15u 200u)
VSIG sig 0 dc 0 ac 1 pulse(0 {step_v} 10u 20n 20n 10u 200u)
VCM icm 0 pulse(.6 {.6+icm_step} 75u 20n 20n 15u 200u)
EFP fp icm value={(v(sig)-v(outp)+v(outn))/2}
EFN fn icm value={-(v(sig)-v(outp)+v(outn))/2}
VP inp fp dc 0
VN inn fn dc 0
CP outp 0 {load_f}
CN outn 0 {load_f}
IP 0 outp pulse(0 {kick_a} 30u 20n 20n 2u 200u)
IN 0 outn pulse(0 {kick_a} 30u 20n 20n 2u 200u)
XDUT inp inn outp outn vdd 0 vb1 vb2 vb3 ref rs s1p s1n ctl ctl1 amp_035_fan_chopper_cmfb_dual
.control
set noaskquit
set num_threads=1
set numdgt=15
set measdgt=15
op
let cm_bias_v=(v(outp)+v(outn))/2
let s1_bias_v=(v(s1p)+v(s1n))/2
let dm_bias_v=v(outp)-v(outn)
let power_w=-v(vdd)*i(VDD)-v(vb1)*i(VB1)-v(vb2)*i(VB2)-v(vb3)*i(VB3)-v(ref)*i(VREF)-v(rs)*i(VRS)
print cm_bias_v s1_bias_v dm_bias_v power_w
write op.raw all
ac dec 200 1 1g
let closed=db(v(outp)-v(outn))
meas ac closed_gain_10khz_db find closed at=10k
write ac.raw all
tran 2n 150u 0 2n
let end_time=time[length(time)-1]
if abs(end_time-150u) > 1e-12
 echo Error: incomplete transient window
 quit 1
end
let sample_index=vector(length(time))
meas tran edge_0u find sample_index at=0u
let edge_0u=floor(edge_0u)
if edge_0u >= length(time)-1
 let edge_0u=length(time)-2
end
if time[edge_0u] > 0u
 let edge_0u=edge_0u-1
end
if time[edge_0u+1] < 0u
 let edge_0u=edge_0u+1
end
let frac_edge_0u=(0u-time[edge_0u])/(time[edge_0u+1]-time[edge_0u])
meas tran edge_120u find sample_index at=120u
let edge_120u=floor(edge_120u)
